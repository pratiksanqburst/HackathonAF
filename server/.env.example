# ─── Decora — Server Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your credentials.
# This file is safe to commit. Never commit the actual .env file.

# ── LLM Gateway (QBurst / OpenAI-compatible) ──────────────────────────────────
# Required for AI features (slide commentary, deck generation, copilot chat).
# If left blank, the app runs in mock mode with curated fallback responses.
QBURST_GATEWAY_URL=https://llmgateway.qburst.build/v1
QBURST_API_KEY=

# Model to use for chat completions (e.g. gpt-4o-mini, gemini-2.0-flash)
GEMINI_MODEL=gpt-4o-mini

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Express API listens on (default: 5000)
# PORT=5000
